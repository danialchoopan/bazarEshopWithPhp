APP_NAME="بازار"
APP_URL="http://localhost/bazarEshopWithPhp/public/"
APP_DEBUG=true

# Database Configuration
# DB_DRIVER: mysql or sqlite
# For MySQL:
#   DB_DATABASE = database name
#   DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD required
# For SQLite:
#   DB_DATABASE = path to sqlite file (e.g., database/sqlite.db)
#   DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD optional

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=em-bazar-shop-db
DB_USERNAME=root
DB_PASSWORD=

# SQLite example (uncomment to use SQLite):
# DB_DRIVER=sqlite
# DB_DATABASE=database/sqlite.db

UPLOAD_MAX_SIZE=5242880
